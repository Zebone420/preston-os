# INSTANCE ENVIRONMENT TEMPLATE (placeholders only - never real values)
#
# This is the complete environment contract a NEW business instance fills
# in with its OWN values. It is intentionally named env.instance.template
# (not .env.example): this repository's user-level safety guard blocks
# credential-shaped .env* paths by design, and the repo convention
# (env.template) exists for the same reason. Copy it OUTSIDE the repo as
# the deployment's env source (Vercel env vars / host env file) and fill
# every <placeholder>. The bootstrap preflight fails closed on missing
# required values and on any value that reuses an origin-instance
# (Preston) identifier.
#
# RULES
# - Every value below is a placeholder. Never commit a filled copy.
# - Never copy a value from an existing instance. New business = new
#   Supabase projects, new OAuth clients, new tokens, new bucket, new
#   deployment project, new owner identities.
# - Secrets live only in the deployment platform's secret store and the
#   host env file (0600, service user), never in the repo or chat.

# --- Instance identity (non-secret) ---------------------------------------
# Machine slug for this business instance (lowercase, digits, hyphen).
INSTANCE_SLUG=<business-slug>
# Human display name shown by the dashboard.
INSTANCE_DISPLAY_NAME=<Business Display Name>
# 'origin' for the first deployment of a platform lineage, 'clone' for an
# instance reproduced from the platform repo for a different business.
INSTANCE_MODE=<origin|clone>

# --- Instance project refs (non-secret; from the NEW Supabase projects) ---
# The clone's own project refs (the <ref> in https://<ref>.supabase.co).
ORCH_STAGING_PROJECT_REF=<new-staging-project-ref>
ORCH_PRODUCTION_PROJECT_REF=<new-production-project-ref>
# Refs this instance must NEVER touch in any environment. A clone MUST
# list every origin-instance ref here (comma-separated). The runtime
# refuses any database URL containing one of these.
ORCH_FOREIGN_PROJECT_REFS=<origin-staging-ref>,<origin-production-ref>

# --- Emergency shutoff flags (fail-closed: missing means blocked) ---------
DISABLE_ALL_AI_WRITES=true
DISABLE_CLIENT_MESSAGES=true
DISABLE_EMAIL_SEND=true
DISABLE_CALENDAR_WRITES=true
DISABLE_AIRTABLE_PROD_WRITES=true
DISABLE_N8N_ACTIVATION=true
DISABLE_REMOTE_RUNNER=true
DISABLE_PRODUCTION_DEPLOY=true
OWNER_STOP=

# --- Owner identity + login gate (NEW identities; never the origin's) -----
OWNER_EMAIL_ALLOWLIST=<owner@newbusiness.example>
REMOTE_INTAKE_OWNER_IDENTITY=<owner@newbusiness.example>
ORCH_OWNER_IDENTITY=<owner@newbusiness.example>

# --- Supabase (NEW projects; anon key public, service key never in app) ---
SUPABASE_URL=<https://new-ref.supabase.co>
NEXT_PUBLIC_SUPABASE_URL=<https://new-ref.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<new-anon-key>
SUPABASE_RUNTIME_ENV=<staging|production>
SUPABASE_RUNTIME_KEY=<new-anon-key>
SUPABASE_RUNTIME_TOKEN=
SUPABASE_RUNTIME_REFRESH_TOKEN=<new-service-identity-refresh-token>
SUPABASE_RUNTIME_TOKEN_STORE=</abs/path/instance-token-store>

# --- Orchestration host pins (this instance's own host + repo) ------------
ORCH_BASE_COMMIT=<pinned-commit>
ORCH_ALLOWED_PATHS=<apps/dashboard/,docs/>
ORCH_EXECUTION_LEVEL=
ORCH_GIT_EXECUTABLE=</abs/path/git>
ORCH_CANONICAL_REPO=</abs/path/instance-repo>
ORCH_WORKTREES_ROOT=</abs/path/instance-worktrees>
ORCH_REAL_CLAUDE_ENABLED=
ORCH_CLAUDE_EXECUTABLE=
ORCH_CLAUDE_EDIT_TOOLS=
ORCH_ARTIFACTS_ENABLED=
ORCH_CAPABILITY_DRYRUN_ENABLED=
ORCH_REQUIRE_REAL_EXECUTION=
WORKER_AGENT_ID=<slug>-worker
HERMES_AGENT_ID=<slug>-hermes

# --- Control-plane MCP / GPT surfaces (NEW OAuth clients per instance) ----
PRESTON_CONTROL_ENABLED=
PRESTON_CONTROL_OAUTH_CLIENT_ID=<new-oauth-client-uuid>
PRESTON_CONTROL_GPT_OAUTH_CLIENT_ID=<new-gpt-oauth-client-uuid>
PRESTON_CONTROL_GPT_OAUTH_CLIENT_SECRET=<new-secret-in-platform-store-only>
PRESTON_CONTROL_GPT_BRIDGE_KEY=<new-random-32B-key>
PRESTON_CONTROL_GPT_CALLBACK_URL=<exact-callback-url-from-gpt-editor>
PRESTON_CONTROL_PUBLIC_ORIGIN=<https://instance-domain>

# --- Remote/ChatGPT/Telegram intake (NEW tokens/identities; default off) --
REMOTE_INTAKE_ENABLED=
REMOTE_INTAKE_TOKEN=<new-random-token>
CHATGPT_INTAKE_ENABLED=
CHATGPT_INTAKE_TOKEN=<new-random-token>
CHATGPT_OWNER_IDENTITY=<owner@newbusiness.example>
TELEGRAM_BOT_TOKEN=<new-bot-token>
TELEGRAM_OWNER_CHAT_ID=<new-chat-id>
TELEGRAM_OWNER_USER_ID=<new-user-id>
TELEGRAM_INTAKE_ENABLED=
TELEGRAM_WEBHOOK_SECRET=<new-random-secret>
SSOT_STATUS_ENABLED=

# --- Business integrations (this business's OWN accounts; default mock) ---
AIRTABLE_TEST_PAT=<new-pat>
AIRTABLE_TEST_BASE_ID=<new-base-id>
AIRTABLE_TBL_APPOINTMENTS=
AIRTABLE_TBL_LEADS=
AIRTABLE_TBL_PROJECTS=
AIRTABLE_TBL_QUOTES=
GOOGLE_OAUTH_CLIENT_ID=<new-google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<new-google-secret-in-store-only>
GOOGLE_OAUTH_REDIRECT_URI=<https://instance-domain/oauth/callback>
GOOGLE_OAUTH_REFRESH_TOKEN=<new-readonly-refresh-token>
GOOGLE_READONLY_LIVE_ENABLED=

# --- Throughput / model routing (optional; safe defaults in code) ---------
ORCH_MAX_PARALLEL_JOBS=
ORCH_MAX_GOALS_PER_TICK=
ORCH_TICK_SOFT_BUDGET_MS=
ORCH_MODEL_DEFAULT=
